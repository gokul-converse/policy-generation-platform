                                      "props": {
                                        "content": "$9/mo",
                                        "level": 2
                                      }
                                    },
                                    {
                                      "type": "button",
                                      "props": {
                                        "label": "Get Started",
                                        "variant": "outline",
                                        "fullWidth": true
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "card",
                              "props": {
                                "variant": "elevated"
                              },
                              "children": [
                                {
                                  "type": "stack",
                                  "props": {
                                    "direction": "vertical",
                                    "gap": 3
                                  },
                                  "children": [
                                    {
                                      "type": "badge",
                                      "props": {
                                        "label": "Popular",
                                        "variant": "primary"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "props": {
                                        "content": "Pro",
                                        "weight": "bold",
                                        "size": "lg"
                                      }
                                    },
                                    {
                                      "type": "heading",
                                      "props": {
                                        "content": "$29/mo",
                                        "level": 2
                                      }
                                    },
                                    {
                                      "type": "button",
                                      "props": {
                                        "label": "Get Started",
                                        "variant": "primary",
                                        "fullWidth": true
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "card",
                              "props": {
                                "variant": "bordered"
                              },
                              "children": [
                                {
                                  "type": "stack",
                                  "props": {
                                    "direction": "vertical",
                                    "gap": 3
                                  },
                                  "children": [
                                    {
                                      "type": "text",
                                      "props": {
                                        "content": "Enterprise",
                                        "weight": "bold",
                                        "size": "lg"
                                      }
                                    },
                                    {
                                      "type": "heading",
                                      "props": {
                                        "content": "Custom",
                                        "level": 2
                                      }
                                    },
                                    {
                                      "type": "button",
                                      "props": {
                                        "label": "Contact Sales",
                                        "variant": "outline",
                                        "fullWidth": true
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "card",
              "props": {
                "title": "Progress Indicators"
              },
              "children": [
                {
                  "type": "stack",
                  "props": {
                    "direction": "vertical",
                    "gap": 4
                  },
                  "children": [
                    {
                      "type": "progress",
                      "props": {
                        "label": "Project Completion",
                        "value": 75,
                        "variant": "success",
                        "showValue": true
                      }
                    },
                    {
                      "type": "progress",
                      "props": {
                        "label": "Storage Used",
                        "value": 45,
                        "variant": "info",
                        "showValue": true
                      }
                    },
                    {
                      "type": "progress",
                      "props": {
                        "label": "Bandwidth",
                        "value": 90,
                        "variant": "warning",
                        "showValue": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
