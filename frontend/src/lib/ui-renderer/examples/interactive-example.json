                        "content": {
                          "type": "grid",
                          "props": {
                            "columns": 3,
                            "gap": 4
                          },
                          "children": [
                            {
                              "type": "card",
                              "props": {
                                "variant": "bordered"
                              },
                              "children": [
                                {
                                  "type": "stack",
                                  "props": {
                                    "direction": "vertical",
                                    "gap": 3
                                  },
                                  "children": [
                                    {
                                      "type": "text",
                                      "props": {
                                        "content": "Starter",
                                        "weight": "bold",
                                        "size": "lg"
