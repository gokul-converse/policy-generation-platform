{
  "version": "1.0",
  "metadata": {
    "title": "Employee Expense Reimbursement Policy",
    "description": "Policy detailing eligible expenses, per-grade limits, claim timelines, advances, and controls to ensure timely and fair reimbursement.",
    "policyType": "Expense Policy",
    "effectiveDate": "2027-04-01",
    "reviewDate": "2028-04-01"
  },
  "theme": {
    "palette": "blue",
    "mode": "light"
  },
  "components": [
    {
      "type": "container",
      "props": {
        "maxWidth": "xl",
        "padding": 4,
        "gap": 4
      },
      "children": [
        {
          "type": "heading",
          "props": {
            "content": "Employee Expense Reimbursement Policy",
            "level": 1,
            "size": "xl"
          }
        },
        {
          "type": "badge",
          "props": {
            "label": "Version 2.1",
            "variant": "info"
          }
        },
        {
          "type": "text",
          "props": {
            "content": "Policy Owner: Finance Department • Effective Date: 01 April 2027 • Scope: This policy applies to all full-time and part-time employees of [Company Name] who incurexpenses while performing official duties."
          }
        },
        {
          "type": "divider",
          "props": {}
        },
        {
          "type": "accordion",
          "props": {
            "items": [
              {
                "id": "purpose",
                "label": "Purpose",
                "content": {
                  "type": "text",
                  "props": {
                    "content": "To define which business expenses are reimbursable, the limits that apply, and the process for claiming and approving them."
                  }
                }
              },
              {
                "id": "scope",
                "label": "Scope",
                "content": {
                  "type": "text",
                  "props": {
                    "content": "This policy applies to all full-time and part-time employees of [Company Name] who incur expenses while performing official duties."
                  }
                }
              },
              {
                "id": "eligible-expenses",
                "label": "Eligible Expenses",
                "content": {
                  "type": "stack",
                  "props": {
                    "direction": "vertical",
                    "gap": 2
                  },
                  "children": [
                    {
                      "type": "text",
                      "props": {
                        "content": "Eligible expenses are reimbursable only when they are reasonable, business-related, and supported by valid receipts. Eligible expense categories include:"
                      }
                    },
                    {
                      "type": "list",
                      "props": {
                        "variant": "bullet",
                        "items": [
                          { "id": "e1", "content": "Travel (air, rail, taxi, and fuel)" },
                          { "id": "e2", "content": "Accommodation during official travel" },
                          { "id": "e3", "content": "Meals during official travel" },
                          { "id": "e4", "content": "Client entertainment (with prior approval)" },
                          { "id": "e5", "content": "Training and conference fees" }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "accordion",
          "props": {
            "items": [
              {
                "id": "expense-limits",
                "label": "Expense Limits",
                "content": {
                  "type": "stack",
                  "props": {
                    "direction": "vertical",
                    "gap": 2
                  },
                  "children": [
                    {
                      "type": "text",
                      "props": {
                        "content": "The following limits apply per employee grade."
                      }
                    },
                    {
                      "type": "table",
                      "props": {
                        "columns": [
                          { "key": "type", "label": "Expense Type", "align": "left" },
                          { "key": "staff", "label": "Staff", "align": "right" },
                          { "key": "manager", "label": "Manager", "align": "right" },
                          { "key": "director", "label": "Director", "align": "right" }
                        ],
                        "data": [
                          { "type": "Accommodation (per night)", "staff": 4000, "manager": 6000, "director": 10000 },
                          { "type": "Meals (per day)", "staff": 1000, "manager": 1500, "director": 2500 },
                          { "type": "Local Travel (per day)", "staff": 1200, "manager": 2000, "director": 3500 },
                          { "type": "Client Entertainment (per event)", "staff": "Not eligible", "manager": 5000, "director": 10000 }
                        ],
                        "striped": true
                      }
                    }
                    ,
                    {
                      "type": "text",
                      "props": {
                        "content": "Note: Expenses above these limits require prior written approval from the Finance Head."
                      }
                    }
                  ]
                }
              },
              {
                "id": "claim-process",
                "label": "Claim Process",
                "content": {
                  "type": "stack",
                  "props": {
                    "direction": "vertical",
                    "gap": 2
                  },
                  "children": [
                    {
                      "type": "text",
                      "props": {
                        "content": "Claims must follow these steps:"
                      }
                    },
                    {
                      "type": "list",
                      "props": {
                        "variant": "numbered",
                        "items": [
                          { "id": "step1", "content": "Submit the claim in the expense portal within 15 days of incurring the expense." },
                          { "id": "step2", "content": "Attach original receipts or invoices for every item above INR 500." },
                          { "id": "step3", "content": "The reporting manager reviews and approves the claim within three working days." },
                          { "id": "step4", "content": "Finance verifies the claim and processes payment within seven working days of approval." }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "id": "non-reimbursable",
                "label": "Non-Reimbursable Expenses",
                "content": {
                  "type": "stack",
                  "props": {
                    "direction": "vertical",
                    "gap": 2
                  },
                  "children": [
                    {
                      "type": "text",
                      "props": {
                        "content": "The following expenses will not be reimbursed:"
                      }
                    },
                    {
                      "type": "list",
                      "props": {
                        "variant": "bullet",
                        "items": [
                          { "id": "nr1", "content": "Personal expenses and family travel" },
                          { "id": "nr2", "content": "Fines, penalties, and traffic violations" },
                          { "id": "nr3", "content": "Alcohol and tobacco" },
                          { "id": "nr4", "content": "Expenses without valid receipts" }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "id": "advances",
                "label": "Advances",
                "content": {
                  "type": "text",
                  "props": {
                    "content": "Employees travelling for more than three days may request an advance of up to 70 percent of the estimated trip cost. The advance must be settled within seven days of returning from the trip. Unsettled advances will be recovered from the next salary."
                  }
                }
              },
              {
                "id": "audits",
                "label": "Audits and Misuse",
                "content": {
                  "type": "text",
                  "props": {
                    "content": "Finance may audit any claim at any time. Submitting false or duplicate claims is a serious violation and may result in disciplinary action, up to and including termination, and recovery of the amount paid."
                  }
                }
              },
              {
                "id": "review",
                "label": "Review and Revision",
                "content": {
                  "type": "text",
                  "props": {
                    "content": "This policy will be reviewed annually by the Finance Department."
                  }
                }
              }
            ]
          }
        },
        {
          "type": "text",
          "props": {
            "content": "By following this policy, employees help the company control costs and ensure that every legitimate business expense is reimbursed quickly and fairly."
          }
        }
      ]
    }
  ]
}