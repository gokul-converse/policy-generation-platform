{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy UI Definition",
  "description": "Draft contract. Must be verified against the frontend renderer before production use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadata",
    "theme",
    "components"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "policyType": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "reviewDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette"
      ],
      "properties": {
        "palette": {
          "enum": [
            "blue",
            "indigo",
            "teal",
            "green",
            "purple",
            "amber",
            "slate",
            "rose"
          ]
        },
        "mode": {
          "enum": [
            "light"
          ]
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "props"
      ],
      "properties": {
        "type": {
          "enum": [
            "container",
            "stack",
            "row",
            "grid",
            "spacer",
            "divider",
            "heading",
            "text",
            "badge",
            "alert",
            "card",
            "list",
            "table",
            "progress",
            "chart",
            "tabs",
            "accordion",
            "form",
            "input",
            "textarea",
            "select",
            "checkbox",
            "radio",
            "button"
          ]
        },
        "props": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxWidth": {
                    "enum": [
                      "sm",
                      "md",
                      "lg",
                      "xl",
                      "full"
                    ]
                  },
                  "padding": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "gap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stack"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "enum": [
                      "vertical",
                      "horizontal"
                    ]
                  },
                  "gap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "row"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "gap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "justify": {
                    "enum": [
                      "start",
                      "center",
                      "end",
                      "between",
                      "around"
                    ]
                  },
                  "align": {
                    "enum": [
                      "start",
                      "center",
                      "end",
                      "stretch"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grid"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "gap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "size": {
                    "enum": [
                      "sm",
                      "md",
                      "lg",
                      "xl",
                      "2xl",
                      "3xl"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "size": {
                    "enum": [
                      "xs",
                      "sm",
                      "md",
                      "lg",
                      "xl",
                      "2xl"
                    ]
                  },
                  "weight": {
                    "enum": [
                      "normal",
                      "medium",
                      "semibold",
                      "bold"
                    ]
                  },
                  "variant": {
                    "enum": [
                      "default",
                      "muted",
                      "caption",
                      "lead"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "badge"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "default",
                      "info",
                      "success",
                      "warning",
                      "danger"
                    ]
                  }
                },
                "required": [
                  "label"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "alert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "info",
                      "success",
                      "warning",
                      "danger"
                    ]
                  }
                },
                "required": [
                  "title",
                  "message"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "card"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "bordered",
                      "elevated",
                      "subtle"
                    ]
                  },
                  "padding": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                },
                "required": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "variant": {
                    "enum": [
                      "bullet",
                      "numbered"
                    ]
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "content"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "label"
                      ],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "align": {
                          "enum": [
                            "left",
                            "center",
                            "right"
                          ]
                        }
                      }
                    }
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  },
                  "striped": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "columns",
                  "data"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "progress"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "chartType": {
                    "enum": [
                      "bar",
                      "line",
                      "pie"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "value"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "chartType",
                  "title",
                  "data"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tabs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label",
                        "content"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "content": {
                          "$ref": "#/$defs/component"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "accordion"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "title",
                        "content"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "content": {
                          "$ref": "#/$defs/component"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "label",
                        "type"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "text",
                            "number",
                            "date",
                            "select",
                            "textarea",
                            "checkbox",
                            "radio"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "placeholder": {
                          "type": "string"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "helpText": {
                          "type": "string"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "submitLabel": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "fields"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "inputType": {
                    "enum": [
                      "text",
                      "number",
                      "date",
                      "email"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placeholder": {
                    "type": "string"
                  },
                  "helpText": {
                    "type": "string"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "inputType"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "textarea"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placeholder": {
                    "type": "string"
                  },
                  "helpText": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "label"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placeholder": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "options"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "checkbox"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "radio"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "options"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "primary",
                      "secondary",
                      "ghost"
                    ]
                  },
                  "actionId": {
                    "type": "string"
                  }
                },
                "required": [
                  "label"
                ]
              }
            }
          }
        }
      ]
    }
  }
}